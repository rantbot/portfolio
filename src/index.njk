---
layout: base.njk
title: Ran Craycraft
---
<section class="hero">
  <h1 class="hero-title serif">{{ site.headline }}</h1>
  <div class="grid hero-body">
    <div class="span-main hero-text">
      <p class="lede serif">{{ site.intro }}</p>
      <p class="hero-now">{{ site.now }}</p>
      <p class="hero-more"><a href="/about/" class="arrow-link">More about me</a></p>
    </div>
  </div>
</section>

{%- set stories = collections.posts | stories %}
{%- if stories.length %}
<section aria-labelledby="stories-h" class="section">
  <div class="section-head">
    <h2 id="stories-h" class="eyebrow strong">Stories</h2>
    <p class="section-note">The bigger work, told in full</p>
    <div class="carousel-nav">
      <span class="carousel-count" aria-live="polite" hidden></span>
      <button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous stories" hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg></button>
      <button type="button" class="carousel-btn" data-dir="1" aria-label="Next stories" hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg></button>
    </div>
  </div>
  <div class="carousel" role="region" aria-label="Story cards, scroll sideways for more" tabindex="0">
  <ul class="carousel-track">
    {%- for p in stories %}
    <li><a href="{{ p.url }}" class="card">
      <span class="media">{% set ratio = "4 / 3" %}{% include "story-cover.njk" %}</span>
      <span class="card-title serif">{{ p.data.title }}</span>
      <span class="card-desc">{{ p.data.description }}</span>
      {%- if p.data.case_study and p.data.case_study.organization %}<span class="card-meta">{{ p.data.case_study.organization }}</span>{% endif %}
    </a></li>
    {%- endfor %}
  </ul>
  </div>
  <p class="section-foot"><a href="/stories/" class="arrow-link">All {{ stories.length }} stories</a></p>
</section>
{%- endif %}

<section aria-labelledby="latest-h" class="section">
  <div class="section-head">
    <h2 id="latest-h" class="eyebrow strong">Latest</h2>
    <p class="section-note">Ideas, experiments and essays</p>
    <div class="filter" role="group" aria-label="Show" hidden>
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="writing" aria-pressed="false">Writing</button>
      <button type="button" data-filter="making" aria-pressed="false">Making</button>
    </div>
  </div>
  <div class="feed">
    {%- for m in collections.posts | stream(elsewhere) | limit(24) | byMonth %}
    <section class="month grid" aria-label="{{ m.month }} {{ m.year }}">
      <h3 class="rail month-label"><span>{{ m.month }}</span> <span class="month-year">{{ m.year }}</span></h3>
      <ol class="span-wide entries-feed">
        {%- for p in m.items %}
        {%- set making = p.data.kind == "making" %}
        <li data-kind="{{ p.data.kind }}">
          <a href="{{ p.url }}" class="line{% if making %} has-thumb{% endif %}">
            <span class="line-main">
              <span class="line-title serif">{{ p.data.title }}</span>
              <span class="line-desc">{{ p.data.description }}</span>
            </span>
            <span class="line-meta">
              <span class="line-kind">{{ "Making" if making else "Writing" }}{% if p.external %} <span class="ext" aria-label="on the thoughtbot blog, opens the original">↗</span>{% endif %}</span>
              <time datetime="{{ p.date | isoDate }}">{{ p.date | dayMonth }}</time>
            </span>
            {%- if making %}<span class="line-thumb" aria-hidden="true">{% set ratio = "4 / 3" %}{% include "cover.njk" %}</span>{% endif %}
          </a>
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endfor %}
  </div>
  <div class="grid section-foot">
    <p class="span-main"><a href="/writing/" class="arrow-link">All writing</a><a href="/making/" class="arrow-link">Everything I’ve made</a></p>
  </div>
</section>

{% include "contact.njk" %}
