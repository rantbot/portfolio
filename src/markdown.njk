---
# Markdown versions of each post, Leading piece and the About page, at the page's address with .md on the end.
# Linked from each page's <head> and from llms.txt. Built from the source files, with private <!-- notes --> removed.
pagination:
  data: collections.markdown
  size: 1
  alias: p
permalink: "{{ p.url | mdUrl }}"
eleventyExcludeFromCollections: true
---
