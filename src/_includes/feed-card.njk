{#- One piece in the Latest feed. Making shows its picture. Writing gets a typographic panel instead. Expects `p` and `size`. -#}
{%- set making = p.data.kind == "making" %}
<a href="{{ p.url }}" class="piece piece-{{ size }} {{ 'is-making' if making else 'is-writing' }}">
  {%- if making %}
  <span class="media">{% set ratio = "4 / 3" %}{% include "cover.njk" %}</span>
  {%- else %}
  <span class="media text-panel" aria-hidden="true">
    <span class="text-panel-kicker">{{ p.data.publication if p.external else "Writing" }}</span>
    <span class="text-panel-title">{{ p.data.title }}</span>
  </span>
  {%- endif %}
  <span class="piece-body">
    <span class="piece-kind">{{ "Making" if making else "Writing" }}{% if p.external %} <span class="ext">↗</span>{% endif %}<span class="dot">·</span><time datetime="{{ p.date | isoDate }}">{{ p.date | dayMonth }}</time></span>
    <span class="piece-title serif">{{ p.data.title }}</span>
    <span class="piece-desc">{{ p.data.description }}</span>
  </span>
</a>
