{#- The address is scrambled in the page so bots can't read it. site.js builds the real link for people.
   Optional: set email_label to keep a label instead of showing the address, and email_subject / email_body to prefill the email. -#}
<a href="/work/" class="{{ email_class or 'ul' }} email-link" data-e="{{ site.email | scramble }}"{% if email_label %} data-keep-label{% endif %}{% if email_subject %} data-subject="{{ email_subject }}"{% endif %}{% if email_body %} data-body="{{ email_body }}"{% endif %}>{{ email_label or "Email me" }}</a>
