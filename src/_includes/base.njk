<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="theme-color" content="#FAFAF7">
{%- set pageTitle = (title + " · " + site.name) if (title and title != site.name) else (site.name + " · " + site.headline) %}
{%- set pageDescription = description or site.description %}
{%- set canonical = env.url + page.url %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="author" content="{{ site.name }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:type" content="{{ 'article' if kind else 'website' }}">
{%- if image %}
<meta property="og:image" content="{{ env.url }}{{ image }}">
<meta name="twitter:card" content="summary_large_image">
{%- else %}
<meta property="og:image" content="{{ env.url }}/assets/og-default.png">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preload" href="/assets/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
{%- include "schema.njk" %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="wrap">
<header class="site-header">
  <a href="/" class="brand"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.name }}</a>
  <nav class="site-nav" aria-label="Main">
    <a href="/stories/"{% if section == "stories" %} aria-current="page"{% endif %}>Stories</a>
    <a href="/writing/"{% if section == "writing" %} aria-current="page"{% endif %}>Writing</a>
    <a href="/making/"{% if section == "making" %} aria-current="page"{% endif %}>Making</a>
    <a href="/about/"{% if section == "about" %} aria-current="page"{% endif %}>About</a>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer grid">
  <p class="rail footer-name">{{ site.name }}</p>
  <nav class="footer-col" aria-label="Sections">
    <a href="/stories/">Stories</a>
    <a href="/writing/">Writing</a>
    <a href="/making/">Making</a>
    <a href="/about/">About</a>
  </nav>
  <nav class="footer-col" aria-label="Elsewhere">
    {%- for p in site.same_as %}{% if "[" not in p.url %}<a href="{{ p.url }}" rel="me">{{ p.label }}</a>{% endif %}{% endfor %}
    <a href="/feed.xml">RSS</a>
  </nav>
  <p class="footer-legal">© {{ env.year }} {{ site.name }}. {{ site.location }}.</p>
</footer>
</div>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
