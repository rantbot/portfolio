---
layout: base.njk
---
<article class="article">
  <header class="article-head grid">
    <p class="rail eyebrow"><a href="/{{ section }}/" class="ul">{{ kind | kindLabel }}</a></p>
    <div class="span-main">
      <h1 class="article-title serif">{{ title }}</h1>
      {%- if description %}<p class="lede serif">{{ description }}</p>{% endif %}
    </div>
  </header>

  <div class="grid article-grid">
    <aside class="rail article-meta" aria-label="About this post">
      <p><a href="/about/" rel="author" class="strong">{{ site.name }}</a></p>
      <p><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      <p>{{ content | readingTime }}</p>
      {%- if series %}<p>{{ series }}</p>{% endif %}
      {%- if meta %}<p>{{ meta }}</p>{% endif %}
    </aside>

    <div class="span-main">
      {%- if image or cover_lines %}
      <figure class="article-cover">
        {%- set p = { data: { image: image, image_alt: image_alt, tone: tone, ink: ink, cover_lines: cover_lines, cover_kicker: cover_kicker, series: series } } %}
        {%- set ratio = "16 / 9" %}{% include "cover.njk" %}
        {%- if image_caption %}<figcaption class="meta">{{ image_caption }}</figcaption>{% endif %}
      </figure>
      {%- endif %}

      {%- if tldr %}
      <aside class="tldr" aria-label="In short">
        <p class="eyebrow strong">In short</p>
        <p>{{ tldr }}</p>
      </aside>
      {%- endif %}

      <div class="prose serif">
{{ content | safe }}
      </div>

      {%- if skill and skills[skill] %}{% set sk = skills[skill] %}{% include "skill-panel.njk" %}{% endif %}

      {%- if try_url %}
      <p class="try"><a href="{{ try_url }}" class="arrow-link">{{ try_label or "Try it" }}</a></p>
      {%- endif %}

      {%- set siblings = collections.posts | inSeries(series) %}
      {%- if siblings.length > 1 %}
      <nav class="series" aria-label="{{ series }}, a series">
        <p class="eyebrow strong">{{ series }}<span class="series-count">{{ siblings.length }} parts</span></p>
        <ol>
          {%- for s in siblings %}
          <li>{% if s.url == page.url %}<span class="current" aria-current="page">{{ s.data.title }}</span>{% else %}<a href="{{ s.url }}">{{ s.data.title }}</a>{% endif %}</li>
          {%- endfor %}
        </ol>
      </nav>
      {%- endif %}

      <aside class="author" aria-label="About the author">
        <p><a href="/about/" class="strong">{{ site.name }}</a> leads the Americas business at thoughtbot, serves as President of Ruby Central, and writes here about leading through change and the things he makes.</p>
      </aside>
    </div>
  </div>

  {%- set nb = collections.posts | neighbors(page) %}
  {%- if nb.older or nb.newer %}
  <nav class="section grid post-nav" aria-labelledby="post-nav-h">
    <h2 id="post-nav-h" class="rail eyebrow strong">Keep reading</h2>
    <ul class="span-wide post-nav-list">
      {%- for item in [{ p: nb.older, dir: "older", label: "Older" }, { p: nb.newer, dir: "newer", label: "Newer" }] %}
      {%- if item.p %}{% set p = item.p %}
      <li class="post-nav-{{ item.dir }}"><a href="{{ p.url }}" class="card" rel="{{ 'prev' if item.dir == 'older' else 'next' }}" data-nav="{{ item.dir }}">
        <span class="media">{% set ratio = "16 / 9" %}{% include "cover.njk" %}</span>
        <span class="eyebrow"><span class="post-nav-dir">{{ item.label }}</span><span class="dot">·</span>{{ p.data.kind | kindLabel }}</span>
        <span class="card-title serif">{{ p.data.title }}</span>
        <span class="card-meta"><time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time></span>
      </a></li>
      {%- else %}<li class="post-nav-{{ item.dir }}" aria-hidden="true"></li>
      {%- endif %}
      {%- endfor %}
    </ul>
    <p class="span-wide section-foot post-nav-foot"><a href="/{{ section }}/" class="arrow-link">All {{ kind | kindLabel }}</a><span class="post-nav-keys meta" hidden>Use the ← and → keys to move between posts.</span></p>
  </nav>
  {%- endif %}
</article>
