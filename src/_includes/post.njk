---
layout: base.njk
---
<article class="article">
  <header class="article-head grid">
    <p class="rail eyebrow"><a href="/{{ section }}/" class="ul">{{ kind | kindLabel }}</a></p>
    <div class="span-main">
      <h1 class="article-title serif">{{ title }}</h1>
      {%- if description %}<p class="lede serif">{{ description }}</p>{% endif %}
    </div>
  </header>

  <div class="grid article-grid">
    <aside class="rail article-meta" aria-label="About this post">
      <p><a href="/about/" rel="author" class="strong">{{ site.name }}</a></p>
      <p><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      <p>{{ content | readingTime }}</p>
      {%- if series %}<p>{{ series }}</p>{% endif %}
      {%- if meta %}<p>{{ meta }}</p>{% endif %}
    </aside>

    <div class="span-main">
      {%- if image or cover_lines %}
      <figure class="article-cover">
        {%- set p = { data: { image: image, image_alt: image_alt, tone: tone, ink: ink, cover_lines: cover_lines, cover_kicker: cover_kicker, series: series } } %}
        {%- set ratio = "16 / 9" %}{% include "cover.njk" %}
        {%- if image_caption %}<figcaption class="meta">{{ image_caption }}</figcaption>{% endif %}
      </figure>
      {%- endif %}

      {%- if tldr %}
      <aside class="tldr" aria-label="In short">
        <p class="eyebrow strong">In short</p>
        <p>{{ tldr }}</p>
      </aside>
      {%- endif %}

      {%- set nb = collections.posts | neighbors(page) %}
      {%- set upNext = nb.newer or nb.older %}
      {%- set picks = collections.posts | related(page, [upNext], 4) %}
      {%- set alsoHtml %}{% if picks[0] %}{% set p = picks[0] %}
<aside class="also" aria-label="You might also like"><a href="{{ p.url }}">
  <span class="media also-thumb">{% set ratio = "1 / 1" %}{% include "cover.njk" %}</span>
  <span class="also-body">
    <span class="eyebrow strong">You might also like</span>
    <span class="also-title serif">{{ p.data.title }}</span>
    <span class="also-desc">{{ p.data.description }}</span>
  </span>
</a></aside>{% endif %}{% endset %}

      <div class="prose serif">
{{ content | insertAside(alsoHtml) | safe }}
      </div>

      {%- if skill and skills[skill] %}{% set sk = skills[skill] %}{% include "skill-panel.njk" %}{% endif %}

      {%- if try_url %}
      <p class="try"><a href="{{ try_url }}" class="arrow-link">{{ try_label or "Try it" }}</a></p>
      {%- endif %}

      {%- set siblings = collections.posts | inSeries(series) %}
      {%- if siblings.length > 1 %}
      <nav class="series" aria-label="{{ series }}, a series">
        <p class="eyebrow strong">{{ series }}<span class="series-count">{{ siblings.length }} parts</span></p>
        <ol>
          {%- for s in siblings %}
          <li>{% if s.url == page.url %}<span class="current" aria-current="page">{{ s.data.title }}</span>{% else %}<a href="{{ s.url }}">{{ s.data.title }}</a>{% endif %}</li>
          {%- endfor %}
        </ol>
      </nav>
      {%- endif %}

      <aside class="author" aria-label="About the author">
        <img class="author-photo" src="/assets/images/ran-craycraft-avatar.jpg" alt="" width="56" height="56" loading="lazy">
        <p><a href="/about/" class="strong">{{ site.name }}</a> is Managing Director at thoughtbot and President of Ruby Central. He writes here about what he’s building and what he’s learning along the way.</p>
      </aside>
    </div>
  </div>

  {%- if upNext %}
  <section class="keep" aria-labelledby="keep-h">
    <div class="grid">
      <h2 id="keep-h" class="rail eyebrow strong">Keep reading</h2>
      <div class="span-wide">
        {%- set p = upNext %}
        <a href="{{ p.url }}" class="up-next" data-nav="{{ 'newer' if p == nb.newer else 'older' }}">
          <span class="media up-next-media">{% set ratio = "3 / 2" %}{% include "cover.njk" %}</span>
          <span class="up-next-body">
            <span class="eyebrow"><span class="strong">Up next</span><span class="dot">·</span>{{ p.data.kind | kindLabel }}<span class="dot">·</span><time datetime="{{ p.date | isoDate }}" data-relative>{{ p.date | readableDate }}</time></span>
            <span class="up-next-title serif">{{ p.data.title }}</span>
            {%- if p.data.description %}<span class="up-next-desc serif">{{ p.data.description }}</span>{% endif %}
            <span class="arrow-link up-next-go">Read it</span>
          </span>
        </a>

        {%- set more = picks.slice(1, 4) %}
        {%- if more.length %}
        {%- set sameSeries = series and (more | inSeries(series)).length == more.length %}
        <h3 class="eyebrow strong more-h">{{ ("More from " + series) if sameSeries else "More like this" }}</h3>
        <ul class="more-list">
          {%- for p in more %}
          <li><a href="{{ p.url }}" class="card">
            <span class="media">{% set ratio = "4 / 3" %}{% include "cover.njk" %}</span>
            <span class="eyebrow">{{ p.data.kind | kindLabel }}<span class="dot">·</span><time datetime="{{ p.date | isoDate }}" data-relative>{{ p.date | dayMonth }}</time></span>
            <span class="card-title serif">{{ p.data.title }}</span>
            <span class="card-desc">{{ p.data.description }}</span>
          </a></li>
          {%- endfor %}
        </ul>
        {%- endif %}

        {%- set other = nb.older if upNext == nb.newer else none %}
        {%- if other %}
        <nav class="pager" aria-label="Older post">
          <a href="{{ other.url }}" class="pager-older" rel="prev" data-nav="older"><span class="eyebrow">← Older</span><span class="pager-title serif">{{ other.data.title }}</span></a>
        </nav>
        {%- endif %}
        <p class="keep-foot"><a href="/{{ section }}/" class="arrow-link">All {{ kind | kindLabel }}</a><span class="post-nav-keys meta" hidden>Use the ← and → keys to move between posts.</span></p>
      </div>
    </div>
  </section>
  {%- endif %}
</article>
