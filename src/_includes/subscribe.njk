<section id="subscribe" class="subscribe" aria-labelledby="subscribe-h">
  <div>
    <h2 id="subscribe-h" class="serif">{{ site.newsletter.name }}</h2>
    <p class="muted">{{ site.newsletter.pitch }}</p>
  </div>
  {%- if site.newsletter.buttondown_username %}
  <form action="https://buttondown.com/api/emails/embed-subscribe/{{ site.newsletter.buttondown_username }}" method="post" target="_blank">
    <label for="sub-email" class="sr">Email address</label>
    <input id="sub-email" type="email" name="email" placeholder="you@example.com" required>
    <button type="submit">Subscribe</button>
  </form>
  {%- else %}
  <p class="sub-fallback">Follow along with the <a href="/feed.xml" class="ul">RSS feed</a>.</p>
  {%- endif %}
</section>
