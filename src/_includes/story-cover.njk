{#- A story's cover. Uses the photo if there is one, otherwise the organization's name set large (cover_lines if there's no organization),
   so the cards are easy to tell apart and navigate. Expects `p` and `ratio`. -#}
{%- set d = p.data -%}
{%- if d.image %}
<img class="cover-img" src="{{ d.image }}" alt="{{ d.image_alt or '' }}" loading="lazy" style="aspect-ratio: {{ ratio }}">
{%- else %}
<div class="cover story-cover" style="aspect-ratio: {{ ratio }}; background: {{ d.tone or '#EFEFEC' }}; color: {{ d.ink or '#1F1F1C' }}" aria-hidden="true">
  <span class="cover-kicker"></span>
  {%- set org = d.cover_name or (d.case_study.organization if d.case_study else "") %}
  <span class="cover-lines{% if org %} cover-org{% endif %}">
    {%- if org %}<span>{{ org }}</span>{% else %}{%- for line in (d.cover_lines or [d.title]) %}<span{% if loop.last and loop.length > 1 %} class="i"{% endif %}>{{ line }}</span>{% endfor %}{% endif -%}
  </span>
</div>
{%- endif %}
