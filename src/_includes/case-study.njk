---
layout: base.njk
---
{%- set cs = case_study or {} %}
<article class="article case">
  <header class="article-head grid">
    <p class="rail eyebrow"><a href="/stories/" class="ul">Stories</a></p>
    <div class="span-wide">
      <h1 class="case-title serif">{{ title }}</h1>
      {%- if description %}<p class="lede serif">{{ description }}</p>{% endif %}
    </div>
  </header>

  <figure class="case-cover">
    {%- set p = { data: { image: image, image_alt: image_alt, tone: tone, ink: ink, case_study: case_study, title: title, cover_lines: cover_lines } } %}
    {%- set ratio = "21 / 9" %}{% include "story-cover.njk" %}
    {%- if image_caption %}<figcaption class="meta">{{ image_caption }}</figcaption>{% endif %}
  </figure>

  <div class="grid article-grid">
    <aside class="rail case-facts" aria-label="At a glance">
      <dl>
        {%- if cs.organization %}<div><dt>Organization</dt><dd>{{ cs.organization }}</dd></div>{% endif %}
        {%- if cs.challenge or cs.scope %}<div><dt>Focus</dt><dd>{{ cs.challenge or cs.scope }}</dd></div>{% endif %}
        {%- if cs.role %}<div><dt>My role</dt><dd>{{ cs.role }}</dd></div>{% endif %}
        {%- if cs.team %}<div><dt>With</dt><dd>{{ cs.team }}</dd></div>{% endif %}
        {%- if cs.years %}<div><dt>When</dt><dd>{{ cs.years }}</dd></div>{% endif %}
        {%- if cs.outcomes and cs.outcomes.length %}
        <div><dt>Outcomes</dt><dd><ul>{% for o in cs.outcomes %}<li>{{ o }}</li>{% endfor %}</ul></dd></div>
        {%- endif %}
      </dl>
    </aside>

    <div class="span-main">
      {%- if tldr %}
      <aside class="tldr" aria-label="In short">
        <p class="eyebrow strong">In short</p>
        <p>{{ tldr }}</p>
      </aside>
      {%- endif %}
      <div class="prose serif">
{{ content | safe }}
      </div>
      {%- if skill and skills[skill] %}{% set sk = skills[skill] %}{% include "skill-panel.njk" %}{% endif %}
      <p class="article-byline meta"><a href="/about/" rel="author" class="strong">{{ site.name }}</a><span class="dot">·</span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time><span class="dot">·</span>{{ content | readingTime }}</p>
    </div>
  </div>

  <aside class="story-cta grid" aria-label="Work together">
    <div class="span-main">
      <p class="story-cta-title serif">Working on something like this?</p>
      <p class="story-cta-text">I help businesses launch new things and work through tough problems. Tell me what you’re trying to do.</p>
      <p class="closing-actions"><a href="/work/" class="button">Let’s talk</a></p>
    </div>
  </aside>

  {%- set reads = collections.posts | readNext(page, read_next) %}
  {%- set allStories = collections.posts | stories %}
  {%- if reads.length %}
  <nav class="section grid read-next" aria-labelledby="next-h">
    <h2 id="next-h" class="rail eyebrow strong">Read next</h2>
    <ul class="span-wide read-next-list{% if reads.length == 1 %} is-single{% endif %}">
      {%- for r in reads %}{% set p = r.p %}
      <li><a href="{{ p.url }}" class="card">
        <span class="media">{% set ratio = "16 / 10" %}{% include "story-cover.njk" %}</span>
        <span class="eyebrow">{{ r.why }}</span>
        <span class="card-title card-title-lg serif">{{ p.data.title }}</span>
        <span class="card-desc">{{ p.data.description }}</span>
      </a></li>
      {%- endfor %}
    </ul>
    <p class="span-wide section-foot"><a href="/stories/" class="arrow-link">All {{ allStories.length }} stories</a></p>
  </nav>
  {%- endif %}
</article>
