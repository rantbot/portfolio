{#- Structured data that tells search engines and AI tools who wrote what. -#}
{%- set person = {
  "@type": "Person",
  "@id": env.url + "/#person",
  "name": site.name,
  "url": env.url + "/",
  "image": env.url + "/assets/images/ran-craycraft.jpg",
  "description": site.tagline,
  "knowsAbout": ["Launching new products and ventures", "Product strategy", "AI adoption", "Software consulting", "Community building", "Events and physical experiences"],
  "jobTitle": site.job_title,
  "worksFor": { "@type": "Organization", "name": site.employer, "url": site.employer_url },
  "memberOf": { "@type": "Organization", "name": "Ruby Central", "url": "https://rubycentral.org" },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "Syracuse University" },
    { "@type": "CollegeOrUniversity", "name": "University of Cincinnati" }
  ],
  "homeLocation": { "@type": "Place", "name": site.location },
  "sameAs": site.same_as | pluck("url")
} -%}
{%- if kind %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": page.date | isoDate,
  "dateModified": (updated or page.date) | isoDate,
  "url": env.url + page.url,
  "mainEntityOfPage": env.url + page.url,
  "image": env.url + ogImage,
  "author": person,
  "publisher": { "@id": env.url + "/#person" },
  "isPartOf": { "@type": "CreativeWorkSeries", "name": series } if series else none,
  "about": { "@type": "Organization", "name": case_study.organization } if case_study and case_study.organization else none,
  "articleSection": kind | kindLabel
} | json | safe }}</script>
{%- elif page.url == "/about/" %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "url": env.url + page.url,
  "name": title,
  "description": description,
  "mainEntity": person
} | json | safe }}</script>
{%- else %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    person,
    { "@type": "WebSite", "@id": env.url + "/#site", "url": env.url + "/", "name": site.name, "description": site.description, "author": { "@id": env.url + "/#person" } }
  ]
} | json | safe }}</script>
{%- endif %}
{#- Breadcrumbs, so search results show Home › Leading › the piece -#}
{%- if kind %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": site.name, "item": env.url + "/" },
    { "@type": "ListItem", "position": 2, "name": kind | kindLabel, "item": env.url + "/" + section + "/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": env.url + page.url }
  ]
} | json | safe }}</script>
{%- endif %}
