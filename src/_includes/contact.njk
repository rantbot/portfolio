<section class="closing grid" aria-labelledby="contact-h">
  <p class="rail eyebrow">Work with me</p>
  <div class="span-wide">
    <h2 id="contact-h" class="closing-title serif">{{ site.invitation }}</h2>
    <p class="closing-note serif">{{ site.invitation_note }}</p>
    <p class="closing-actions">
      {%- set email_label = "Tell me about your idea" %}{% set email_class = "button" %}{% set email_subject = "An idea I’d like to talk about" %}{% set email_body = "What I’m trying to do:\n\nWhere I’m stuck:\n\nTiming:\n" %}
      {% include "email-link.njk" %}
      {%- set email_label = "" %}{% set email_class = "" %}{% set email_subject = "" %}{% set email_body = "" %}
      <a href="/work/" class="arrow-link">How I can help</a>
    </p>
    <p class="closing-small">For podcasts and events, you can reach me the same way.</p>
  </div>
</section>
