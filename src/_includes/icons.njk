{#- Section icons. Drawn on a 20px grid with a 1.5px round line, like the search icon. Use: {% from "icons.njk" import icon %} then {{ icon("leading") }} -#}
{%- macro icon(name, cls = "icon") -%}
<svg class="{{ cls }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
{%- if name == "leading" %}<circle cx="10" cy="10" r="7.25"/><path d="M10 5.5 12 10l-2 4.5L8 10z"/>
{%- elif name == "writing" %}<path d="M3.5 5.5h13M3.5 10h13M3.5 14.5h7.5"/>
{%- elif name == "making" %}<path d="M10 2.75 16.5 6.5v7L10 17.25 3.5 13.5v-7z"/><path d="M3.5 6.5 10 10l6.5-3.5M10 10v7.25"/>
{%- endif %}</svg>
{%- endmacro %}
